+  it('never resolves by label', () => {
+    expect(findActiveModelSpec(specs, { spec: 'GLM-5' })).toBeUndefined();
+  });
+
+  it('does not match on endpoint alone', () => {
+    expect(findActiveModelSpec(specs, { endpoint: 'bedrock' })).toBeUndefined();
