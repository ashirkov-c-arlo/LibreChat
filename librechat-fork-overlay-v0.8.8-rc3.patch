+
+const CLAUDE_OPTIONS: EffortValue[] = ['low', 'medium', 'high', 'max'];
+const GPT_OPTIONS: EffortValue[] = ['low', 'medium', 'high', 'xhigh'];
+const OSS_OPTIONS: EffortValue[] = ['low', 'medium', 'high'];
+
+const spec = (
